# JanSahayak Backend Configuration Example

# --- Server & Core ---
ENVIRONMENT=development
SECRET_KEY=change-this-in-production-use-a-strong-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# For local testing, defaults to SQLite if left empty or set as below:
DATABASE_URL=sqlite:///./jansahayak.db
# For production Neon PostgreSQL:
# DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# --- AI & Language Services ---
# Groq API for LLM grounded responses (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Bhashini AI Services (Optional / when approved at https://bhashini.gov.in)
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_PIPELINE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
